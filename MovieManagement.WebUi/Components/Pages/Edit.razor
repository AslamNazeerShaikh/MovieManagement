@page "/edit/{id:int}"
@inject IUnitOfWork UoW
@inject NavigationManager Navigation

<PageTitle>Edit Movie</PageTitle>

<div class="row justify-content-center">
    <div class="col-6 m-3">
        <MovieForm IsEditMode="true" MovieId="@Id" OnValidMovieSubmit="EditMovie"></MovieForm>
    </div>
</div>

@code {

    [Parameter] public int Id { get; set; }

    private async Task EditMovie(Movie movie)
    {
        UoW.Movie.Update(movie);
        await UoW.SaveAsync();
        
        Navigation.NavigateTo("/");
    }

}