@page "/"
@inject IUnitOfWork UoW

<PageTitle>Movie List</PageTitle>

<div class="row justify-content-center mt-3">
    <div class="col-6 rounded-2 pt-2 shadow-lg">
        <a href="add-new" class="btn btn-primary mb-3 shadow">Add New</a>
        @if (_movies is null)
        {
            <div class="movie-item">
                Loading Movies. Please wait.
            </div>
        }
        else if (_movies.Any())
        {
            @foreach (var movie in _movies)
            {
                <div class="movie-item">
                    <MovieCard @rendermode="InteractiveServer" Movie="movie"></MovieCard>
                </div>
            }
        }
        else
        {
            <div class="movie-item">No Movies Found.</div>
        }
    </div>
</div>

@code {
    private List<Movie>? _movies;

    protected override async Task OnInitializedAsync()
    {
        //await Task.Delay(1000);
        await Task.CompletedTask;
        var moviesFromRepo = await UoW.Movie.GetAllAsync();
        _movies = moviesFromRepo.ToList();
    }

}